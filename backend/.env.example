# Copy this file to backend/.env and configure it locally.
PORT=5000
NODE_ENV=development

# Authentication and session security
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_SETUP_KEY=replace-with-a-private-admin-setup-key

# MySQL application database
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=lost_found_app
DB_PASSWORD=your_private_database_password
DB_NAME=ucu_lost_found_db

# Frontend origin
FRONTEND_URL=http://localhost:5173
